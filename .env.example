# Dados do recebedor do PIX.
# Copie para .env.local no desenvolvimento e cadastre na Vercel em produção.
#
# ATENÇÃO: por serem NEXT_PUBLIC_, esses valores aparecem no HTML da página.
# É inerente ao PIX estático — qualquer convidado consegue ler a chave.
# Use uma chave aleatória criada no app do banco, não seu CPF.

# Chave PIX (aleatória, e-mail, telefone ou CPF/CNPJ)
NEXT_PUBLIC_PIX_KEY=

# Nome do recebedor exatamente como está cadastrado no banco (máx. 25 caracteres)
NEXT_PUBLIC_PIX_NAME=

# Cidade do recebedor (máx. 15 caracteres)
NEXT_PUBLIC_PIX_CITY=CURITIBA

# Para onde vão os pedidos. Veja docs/planilha.md para montar em ~5 minutos.
# Sem estas duas o site funciona igual, só não registra os pedidos na planilha.

# A URL do app da web do Apps Script (termina em /exec)
SHEETS_WEBHOOK_URL=

# A mesma frase secreta que está no topo do script da planilha
SHEETS_WEBHOOK_SECRET=
